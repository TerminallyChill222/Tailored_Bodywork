---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { intro } from '../data/about';
import { images, scenes, practitioner } from '../data/images';
import { url, rich, bookingHref } from '../lib/utils';

const trust = [
  { icon: 'table', text: 'Professional table & fresh linens' },
  { icon: 'pin', text: `Serving ${site.city} & nearby` },
  { icon: 'sliders', text: 'Clear, upfront pricing' },
  { icon: 'shield', text: '[[Licensed & insured]]' },
];

const benefits = [
  {
    icon: 'sliders',
    title: 'Tailored to you',
    body: 'Every session starts with a conversation. Pressure, pace, and focus are shaped around how you feel that day — not a set routine.',
  },
  {
    icon: 'car',
    title: 'Nothing to drive home from',
    body: 'No traffic before, no traffic after. When your session ends, you’re already home — free to rest, shower, or simply stay put.',
  },
  {
    icon: 'home',
    title: 'Your space, your comfort',
    body: 'Familiar surroundings, your own room temperature and music, and nowhere else you need to be.',
  },
  {
    icon: 'check-circle',
    title: 'Thoughtful & professional',
    body: 'Clear communication, consistent boundaries, and careful setup at every visit — so you always know what to expect.',
  },
];

const details = [
  { caption: 'Fresh linens, every visit', ...scenes.sage.towel },
  { caption: 'Thoughtful details', ...images.supplies },
  { caption: 'Quiet, unhurried care', ...images.eucalyptus },
  { caption: 'Your space, prepared', ...scenes.sage.corner },
];

const assurances = [
  '[[A personal text to confirm the day before]], and another when I’m on my way',
  'I step out while you get settled, and knock before coming back in',
  'Professional draping throughout — only the area being worked on is uncovered',
  'You can adjust, skip, or pause anything, at any time',
];
---

<Layout image={scenes.sage.room.src}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text" data-reveal>
        <p class="eyebrow">Mobile bodywork · {site.city}, {site.region}</p>
        <h1 id="hero-title">Personalized bodywork, in the comfort of <em>your home</em>.</h1>
        <p class="lede">
          Skilled, attentive sessions shaped around your body and your day — brought to your door with a professional
          table, fresh linens, and everything else you need. No traffic. No waiting room. Just time to rest.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={bookingHref()}>
            Book a Session <Icon name="arrow" class="arrow" />
          </a>
          <a class="btn btn--ghost" href="#how-it-works">How It Works</a>
        </div>
        <p class="hero__meta">
          <Icon name="pin" /> Serving {site.city} &amp; nearby neighborhoods
        </p>
      </div>
      <div class="hero__media" data-reveal style="--reveal-delay: .15s">
        <Photo
          src={scenes.sage.room.src}
          alt={scenes.sage.room.alt}
          shape="feature"
          aspect="4 / 5"
          eager
          position="52% center"
          sizes="(min-width: 900px) 45vw, 100vw"
        />
        <div class="hero__float" aria-hidden="true">
          <span class="icon-badge"><Icon name="table" /></span>
          <span>Everything you need,<br />nothing to set up</span>
        </div>
      </div>
    </div>
    <svg class="hero__sprig" viewBox="0 0 200 300" aria-hidden="true">
      <path d="M100 295C98 220 100 140 120 20" />
      <path d="M101 250c-18-8-34-26-38-48 22 4 36 22 38 48Z" />
      <path d="M103 205c16-10 30-28 32-50-20 6-32 24-32 50Z" />
      <path d="M106 160c-16-8-28-24-30-44 20 4 30 20 30 44Z" />
      <path d="M110 118c14-10 24-26 24-44-18 6-26 22-24 44Z" />
      <path d="M114 78c-12-6-20-20-20-34 14 4 22 16 20 34Z" />
    </svg>
  </section>

  <!-- Trust strip -->
  <section class="trust" aria-label="At a glance">
    <div class="container">
      <ul role="list" class="trust__list">
        {
          trust.map((t) => (
            <li>
              <Icon name={t.icon} />
              <span set:html={rich(t.text)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
      <SectionHead
        eyebrow="Why in-home bodywork"
        title="Care that fits your body — *and your life*."
        lede="A great session shouldn’t end with a drive across town. Tailored Bodywork brings skilled, personalized care to the place you’re most at ease."
        align="center"
        id="benefits-title"
      />
      <ul role="list" class="benefits__grid">
        {
          benefits.map((b, i) => (
            <li class="benefit" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
              <span class="icon-badge">
                <Icon name={b.icon} />
              </span>
              <h3 class="h4">{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Detail gallery -->
  <section class="details" aria-label="The details">
    <div class="container">
      <ul role="list" class="details__row">
        {
          details.map((d, i) => (
            <li class="details__item" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <Photo src={d.src} alt={d.alt} shape="feature" aspect="3 / 4.2" sizes="(min-width: 900px) 22vw, 45vw" />
              <p class="details__caption">{d.caption}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Meet your practitioner -->
  <section class="section section--alt meet" aria-labelledby="meet-title">
    <div class="container meet__grid">
      <div class="meet__media" data-reveal>
        <Photo
          src={practitioner.headshot.src}
          alt={practitioner.headshot.alt}
          label={practitioner.headshot.label}
          shape="feature"
          aspect="4 / 5"
          sizes="(min-width: 900px) 40vw, 100vw"
          stock={false}
        />
      </div>
      <div class="meet__text" data-reveal style="--reveal-delay: .12s">
        <p class="eyebrow">Meet your practitioner</p>
        <h2 id="meet-title">Hi, I’m <em>{site.practitioner.firstName}</em>.</h2>
        <p class="meet__sub">I’ll be the one at your door — and I’m glad you’re here.</p>
        <p class="prose" set:html={rich(intro.short)} />
        <ul role="list" class="chips">
          {intro.highlights.map((h) => <li class="chip" set:html={rich(h)} />)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={url('about')}>More about {site.practitioner.firstName}</a>
          <a class="text-link" href={url('experience')}>What to expect <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="section services-preview" aria-labelledby="services-title">
    <div class="container">
      <SectionHead
        eyebrow="Services & pricing"
        title="Sessions shaped around *you*"
        lede="Four ways to book, each one adjusted to your body on the day. Not sure which to choose? The Tailored Session is always a good place to start."
        align="split"
        id="services-title"
      >
        <a class="text-link" href={url('services')}>Full services &amp; pricing <Icon name="arrow" class="arrow" /></a>
      </SectionHead>
      <div class="services-preview__grid">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
      <p class="services-preview__note" set:html={rich(site.serviceArea.travelNote)} />
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--wash how" id="how-it-works" aria-labelledby="how-title">
    <div class="container">
      <SectionHead
        eyebrow="How it works"
        title="Simple from *start to finish*"
        lede="Booking an in-home session takes just a few minutes, and you’ll know exactly what to expect at every step."
        align="center"
        id="how-title"
      />
      <Steps />
      <div class="how__more" data-reveal>
        <a class="btn btn--ghost" href={url('experience')}>Read the full in-home experience <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Experience teaser -->
  <section class="section experience-teaser" aria-labelledby="exp-title">
    <div class="container experience-teaser__grid">
      <div class="experience-teaser__media" data-reveal>
        <Photo src={scenes.sage.oliveLinens.src} alt={scenes.sage.oliveLinens.alt} position="86% center" aspect="5 / 6" sizes="(min-width: 900px) 45vw, 100vw" />
        <div class="experience-teaser__inset">
          <Photo src={scenes.sage.towelDetail.src} alt={scenes.sage.towelDetail.alt} position="35% 40%" aspect="1 / 1" sizes="200px" shape="circle" stock={false} />
        </div>
      </div>
      <div class="experience-teaser__text" data-reveal style="--reveal-delay: .12s">
        <p class="eyebrow">Your in-home experience</p>
        <h2 id="exp-title">Professional, predictable, and <em>on your terms</em></h2>
        <p class="lede">
          Inviting someone into your home is a big deal. Every part of a session is designed so you feel informed,
          comfortable, and in control from the moment you book.
        </p>
        <ul role="list" class="checklist">
          {
            assurances.map((a) => (
              <li>
                <Icon name="check" />
                <span set:html={rich(a)} />
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={url('experience')}>See every step, from booking to goodbye <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- Service area -->
  <section class="section area" aria-labelledby="area-title">
    <div class="container area__grid">
      <div class="area__text" data-reveal>
        <p class="eyebrow">Service area</p>
        <h2 id="area-title">Serving <em>{site.city}</em> and nearby neighborhoods</h2>
        <p class="prose" set:html={rich(site.serviceArea.travelNote)} />
        <ul role="list" class="chips">
          {site.serviceArea.neighborhoods.map((n) => <li class="chip"><Icon name="pin" />{n}</li>)}
        </ul>
        <p class="small area__ask">
          <span class="draft-tag">Example list</span>
          Don’t see your neighborhood? <a href={url('contact')}>Send a quick message</a> — chances are I can still come to you.
        </p>
      </div>
      <div class="area__media" data-reveal style="--reveal-delay: .12s">
        <Photo src={images.denver.src} alt={images.denver.alt} label="Denver skyline with the mountains" aspect="4 / 3" sizes="(min-width: 900px) 45vw, 100vw" />
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .hero__text h1 {
    max-width: 15ch;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .hero__meta :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent);
  }

  .hero__media {
    position: relative;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }

  /* Phones & tablets: photo first, as a shorter dome so the headline still shows on the first screen */
  @media (max-width: 899px) {
    .hero {
      padding-top: 1rem;
    }

    .hero__grid {
      gap: 2rem;
    }

    .hero__media {
      order: -1;
      max-width: none;
    }

    .hero__media :global(.photo__frame) {
      aspect-ratio: auto;
      height: clamp(15rem, 42vh, 26rem);
    }

    .hero__float {
      left: 0.75rem;
      bottom: 1rem;
    }
  }

  .hero__float {
    position: absolute;
    left: -1rem;
    bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.25rem 0.85rem 0.85rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
    font-size: 0.85rem;
    line-height: 1.35;
    z-index: 3;
  }

  .hero__float .icon-badge {
    width: 2.75rem;
    height: 2.75rem;
  }

  .hero__float .icon-badge :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .hero__sprig {
    position: absolute;
    left: -3rem;
    bottom: -3rem;
    width: clamp(10rem, 20vw, 17rem);
    fill: none;
    stroke: var(--accent-soft);
    stroke-width: 1.1;
    opacity: 0.55;
    transform: rotate(-14deg);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(3rem, 6vw, 6rem);
    }

    .hero__media {
      justify-self: end;
    }

    .hero__float {
      left: -3rem;
    }
  }


  /* ---------- Trust strip ---------- */
  .trust {
    border-block: 1px solid var(--line);
    background: var(--bg-alt);
  }

  .trust__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .trust__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.35rem 0.75rem;
    font-size: 0.88rem;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .trust__list :global(.icon) {
    color: var(--accent);
    width: 1.6rem;
    height: 1.6rem;
  }

  @media (min-width: 900px) {
    .trust__list {
      grid-template-columns: repeat(4, 1fr);
    }

    .trust__list li {
      justify-content: center;
      padding-block: 1.75rem;
    }

    .trust__list li + li {
      border-left: 1px dashed var(--line-strong);
    }

  }

  /* ---------- Benefits ---------- */
  .benefits__grid {
    display: grid;
    gap: 2.75rem 2rem;
  }

  .benefit {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    text-align: center;
  }

  .benefit p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 22rem;
  }

  .benefit .icon-badge {
    margin-bottom: 0.4rem;
  }

  @media (min-width: 640px) {
    .benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .benefits__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------- Detail gallery ---------- */
  .details {
    padding-bottom: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  .details__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }

  .details__item {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .details__item:nth-child(even) {
    margin-top: 2.5rem;
  }

  .details__caption {
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line-strong);
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(1.15rem * var(--display-scale));
    line-height: 1.3;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .details__row {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }
  }

  /* ---------- Meet ---------- */
  .meet__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .meet__media {
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }

  .meet__text {
    display: grid;
    gap: 1.35rem;
    justify-items: start;
  }

  .meet__sub {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-style: italic;
    font-size: calc(1.35rem * var(--display-scale));
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .meet .btn-row {
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .meet__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }

  }

  /* ---------- Services preview ---------- */
  .services-preview__grid {
    display: grid;
    gap: 1.75rem 1.25rem;
  }

  .services-preview__note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media (min-width: 680px) {
    .services-preview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .services-preview__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------- How ---------- */
  .how__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  :global([data-theme='sage']) .how :global(.step__num) {
    background: var(--accent-wash);
  }

  :global([data-theme='sage']) .how :global(.icon-badge) {
    background: var(--surface);
  }

  /* ---------- Experience teaser ---------- */
  .experience-teaser__grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .experience-teaser__media {
    position: relative;
    max-width: 34rem;
    width: 100%;
    justify-self: center;
  }

  .experience-teaser__inset {
    position: absolute;
    right: -0.5rem;
    bottom: -2rem;
    width: clamp(7rem, 22vw, 10.5rem);
    padding: 0.4rem;
    border-radius: 50%;
    background: var(--bg);
  }

  .experience-teaser__text {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .checklist {
    display: grid;
    gap: 0.9rem;
    margin-block: 0.5rem;
  }

  .checklist li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    color: var(--ink-soft);
  }

  .checklist :global(.icon) {
    margin-top: 0.15rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
    stroke-width: 1.6;
  }

  @media (min-width: 900px) {
    .experience-teaser__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
  }

  /* ---------- Area ---------- */
  .area__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .area__text {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .area .chip :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--accent);
  }

  .area__ask {
    color: var(--ink-soft);
    line-height: 2;
  }

  .area__ask .draft-tag {
    margin-right: 0.4rem;
  }

  .area__ask a {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .area__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
</style>
