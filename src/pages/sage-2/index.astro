---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Steps from '../../components/Steps.astro';
import Testimonials from '../../components/Testimonials.astro';
import CtaBand from '../../components/CtaBand.astro';
import Sprig from '../../components/Sprig.astro';
import Ornament from '../../components/Ornament.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';
import { intro } from '../../data/about';
import { images, scenes, practitioner } from '../../data/images';
import { url, rich, bookingHref } from '../../lib/utils';

const trust = [
  { icon: 'table', text: 'Professional table & fresh linens' },
  { icon: 'pin', text: `Serving ${site.city} & nearby` },
  { icon: 'sliders', text: 'Clear, upfront pricing' },
  { icon: 'shield', text: '[[Licensed & insured]]' },
];

const benefits = [
  {
    icon: 'sliders',
    title: 'Tailored to you',
    body: 'Every session starts with a conversation. Pressure, pace, and focus are shaped around how you feel that day — not a set routine.',
  },
  {
    icon: 'car',
    title: 'Nothing to drive home from',
    body: 'No traffic before, no traffic after. When your session ends, you’re already home — free to rest, shower, or simply stay put.',
  },
  {
    icon: 'home',
    title: 'Your space, your comfort',
    body: 'Familiar surroundings, your own room temperature and music, and nowhere else you need to be.',
  },
  {
    icon: 'check-circle',
    title: 'Thoughtful & professional',
    body: 'Clear communication, consistent boundaries, and careful setup at every visit — so you always know what to expect.',
  },
];

const details = [
  { caption: 'Fresh linens, every visit', ...scenes.sage.towel },
  { caption: 'Thoughtful details', ...images.supplies },
  { caption: 'Quiet, unhurried care', ...images.eucalyptus },
  { caption: 'Your space, prepared', ...scenes.sage.corner },
];

const assurances = [
  '[[A personal text to confirm the day before]], and another when I’m on my way',
  'I step out while you get settled, and knock before coming back in',
  'Professional draping throughout — only the area being worked on is uncovered',
  'You can adjust, skip, or pause anything, at any time',
];
---

<Layout image={scenes.sage.room.src} variant="a2">
  <!-- Hero (A2): centered editorial headline over a composition of arched photos -->
  <section class="a2-hero" aria-labelledby="hero-title">
    <Sprig kind="fern" bend={-0.5} leaves={18} class="a2-hero__fern a2-hero__fern--l" />
    <Sprig kind="fern" bend={0.5} leaves={18} class="a2-hero__fern a2-hero__fern--r" />

    <div class="container a2-hero__head" data-reveal>
      <p class="eyebrow eyebrow--center">Mobile bodywork · {site.city}, {site.region}</p>
      <h1 id="hero-title">
        Personalized bodywork, in the comfort of{' '}
        <span class="swash"><em>your home</em><svg class="swash__line" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 15 C 60 5, 120 3, 172 9 S 262 19, 296 7" /></svg></span>.
      </h1>
      <p class="lede">
        Skilled, attentive sessions shaped around your body and your day — with a professional table, fresh linens,
        and everything else brought to your door. No traffic. No waiting room. Just time to rest.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={bookingHref()}>
          Book a Session <Icon name="arrow" class="arrow" />
        </a>
        <a class="btn btn--ghost" href="#how-it-works">How It Works</a>
      </div>
    </div>

    <div class="container a2-hero__stage">
      <div class="a2-arch a2-arch--side a2-arch--left" data-reveal style="--reveal-delay: .15s">
        <span class="a2-arch__outline" aria-hidden="true"></span>
        <Sprig kind="olive" bend={-0.55} leaves={11} class="a2-arch__sprig" />
        <Photo src={scenes.sage.oliveVase.src} alt={scenes.sage.oliveVase.alt} shape="feature" aspect="3 / 4" position="center 30%" sizes="(min-width: 900px) 22vw, 30vw" />
      </div>
      <div class="a2-arch a2-arch--center" data-reveal style="--reveal-delay: .05s">
        <span class="a2-arch__outline" aria-hidden="true"></span>
        <Photo src={scenes.sage.room.src} alt={scenes.sage.room.alt} shape="feature" aspect="4 / 5" eager position="52% center" sizes="(min-width: 900px) 34vw, 48vw" />
        <svg class="a2-badge" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="a2-badge-circle" d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1 -90 0" /></defs>
          <circle class="a2-badge__disc" cx="60" cy="60" r="58" />
          <circle class="a2-badge__ring" cx="60" cy="60" r="33" />
          <text><textPath href="#a2-badge-circle" textLength="280" lengthAdjust="spacing">Personalized · In-home · Denver ·</textPath></text>
          <path class="a2-badge__leaf" d="M49 71c0-12 7.5-19.5 20-20 .5 12.4-7.2 20-20 20Z M49 71c4.5-5.2 9.2-9.9 14.7-13.9" />
        </svg>
      </div>
      <div class="a2-arch a2-arch--side a2-arch--right" data-reveal style="--reveal-delay: .25s">
        <span class="a2-arch__outline" aria-hidden="true"></span>
        <Sprig kind="eucalyptus" bend={0.5} leaves={8} class="a2-arch__sprig" />
        <Photo src={scenes.sage.benchDetail.src} alt={scenes.sage.benchDetail.alt} shape="feature" aspect="3 / 4" position="60% center" sizes="(min-width: 900px) 22vw, 30vw" />
      </div>
    </div>

    <p class="container a2-hero__caption" data-reveal>
      <span>Everything you need, nothing to set up</span>
      <span class="a2-hero__dot" aria-hidden="true"></span>
      <span>Serving {site.city} &amp; nearby neighborhoods</span>
    </p>
  </section>

  <!-- Trust ribbon -->
  <section class="ribbon" aria-label="At a glance">
    <ul role="list" class="container ribbon__list">
      {
        trust.map((t) => (
          <li class="ribbon__item">
            <span class="ribbon__icon"><Icon name={t.icon} /></span>
            <span set:html={rich(t.text)} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Benefits -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
      <SectionHead
        eyebrow="Why in-home bodywork"
        title="Care that fits your body — *and your life*."
        lede="A great session shouldn’t end with a drive across town. Tailored Bodywork brings skilled, personalized care to the place you’re most at ease."
        align="center"
        id="benefits-title"
      />
      <ul role="list" class="benefits__grid">
        {
          benefits.map((b, i) => (
            <li class="benefit" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
              <span class="icon-badge">
                <Icon name={b.icon} />
              </span>
              <h3 class="h4">{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Ornament class="a2-orn" />

  <!-- Detail gallery -->
  <section class="details" aria-label="The details">
    <div class="container">
      <ul role="list" class="details__row">
        {
          details.map((d, i) => (
            <li class="details__item" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <Photo src={d.src} alt={d.alt} shape="feature" aspect="3 / 4.2" sizes="(min-width: 900px) 22vw, 45vw" />
              <p class="details__caption">{d.caption}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Meet your practitioner -->
  <section class="section section--alt meet" aria-labelledby="meet-title">
    <div class="container meet__grid">
      <div class="meet__media" data-reveal>
        <span class="a2-arch__outline" aria-hidden="true"></span>
        <Sprig kind="olive" bend={0.5} leaves={12} class="meet__sprig" />
        <Photo
          src={practitioner.headshot.src}
          alt={practitioner.headshot.alt}
          label={practitioner.headshot.label}
          shape="feature"
          aspect="4 / 5"
          sizes="(min-width: 900px) 40vw, 100vw"
          stock={false}
        />
      </div>
      <div class="meet__text" data-reveal style="--reveal-delay: .12s">
        <p class="eyebrow">Meet your practitioner</p>
        <h2 id="meet-title">Hi, I’m <em>{site.practitioner.firstName}</em>.</h2>
        <p class="meet__sub">I’ll be the one at your door — and I’m glad you’re here.</p>
        <p class="prose" set:html={rich(intro.short)} />
        <ul role="list" class="chips">
          {intro.highlights.map((h) => <li class="chip" set:html={rich(h)} />)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={url('about')}>More about {site.practitioner.firstName}</a>
          <a class="text-link" href={url('experience')}>What to expect <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="section services-preview" aria-labelledby="services-title">
    <div class="container">
      <SectionHead
        eyebrow="Services & pricing"
        title="Sessions shaped around *you*"
        lede="Four ways to book, each one adjusted to your body on the day. Not sure which to choose? The Tailored Session is always a good place to start."
        align="split"
        id="services-title"
      >
        <a class="text-link" href={url('services')}>Full services &amp; pricing <Icon name="arrow" class="arrow" /></a>
      </SectionHead>
      <div class="services-preview__grid">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
      <p class="services-preview__note" set:html={rich(site.serviceArea.travelNote)} />
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--wash how" id="how-it-works" aria-labelledby="how-title">
    <div class="container">
      <SectionHead
        eyebrow="How it works"
        title="Simple from *start to finish*"
        lede="Booking an in-home session takes just a few minutes, and you’ll know exactly what to expect at every step."
        align="center"
        id="how-title"
      />
      <Steps wave />
      <div class="how__more" data-reveal>
        <a class="btn btn--ghost" href={url('experience')}>Read the full in-home experience <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Experience teaser -->
  <section class="section experience-teaser" aria-labelledby="exp-title">
    <div class="container experience-teaser__grid">
      <div class="experience-teaser__media" data-reveal>
        <Photo src={scenes.sage.oliveLinens.src} alt={scenes.sage.oliveLinens.alt} position="86% center" aspect="5 / 6" sizes="(min-width: 900px) 45vw, 100vw" />
        <div class="experience-teaser__inset">
          <Photo src={scenes.sage.towelDetail.src} alt={scenes.sage.towelDetail.alt} position="35% 40%" aspect="1 / 1" sizes="200px" shape="circle" stock={false} />
        </div>
      </div>
      <div class="experience-teaser__text" data-reveal style="--reveal-delay: .12s">
        <p class="eyebrow">Your in-home experience</p>
        <h2 id="exp-title">Professional, predictable, and <em>on your terms</em></h2>
        <p class="lede">
          Inviting someone into your home is a big deal. Every part of a session is designed so you feel informed,
          comfortable, and in control from the moment you book.
        </p>
        <ul role="list" class="checklist">
          {
            assurances.map((a) => (
              <li>
                <Icon name="check" />
                <span set:html={rich(a)} />
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={url('experience')}>See every step, from booking to goodbye <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <Ornament class="a2-orn a2-orn--pad" />

  <Testimonials />

  <!-- Service area -->
  <section class="section area" aria-labelledby="area-title">
    <div class="container area__grid">
      <div class="area__text" data-reveal>
        <p class="eyebrow">Service area</p>
        <h2 id="area-title">Serving <em>{site.city}</em> and nearby neighborhoods</h2>
        <p class="prose" set:html={rich(site.serviceArea.travelNote)} />
        <ul role="list" class="chips">
          {site.serviceArea.neighborhoods.map((n) => <li class="chip"><Icon name="pin" />{n}</li>)}
        </ul>
        <p class="small area__ask">
          <span class="draft-tag">Example list</span>
          Don’t see your neighborhood? <a href={url('contact')}>Send a quick message</a> — chances are I can still come to you.
        </p>
      </div>
      <div class="area__media" data-reveal style="--reveal-delay: .12s">
        <Photo src={images.denver.src} alt={images.denver.alt} label="Denver skyline with the mountains" aspect="4 / 3" sizes="(min-width: 900px) 45vw, 100vw" />
      </div>
    </div>
  </section>

  <CtaBand ornate />
</Layout>

<style>
  /* ---------- Hero (A2) ---------- */
  .a2-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .a2-hero__head {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    max-width: 58rem;
    text-align: center;
  }

  .a2-hero__head h1 {
    max-width: 17ch;
  }

  .a2-hero__head .lede {
    margin-inline: auto;
  }

  .a2-hero__head .btn-row {
    justify-content: center;
    margin-top: 0.25rem;
  }

  /* hand-drawn underline that draws itself in */
  .swash {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .swash__line {
    position: absolute;
    left: -3%;
    bottom: -0.16em;
    width: 106%;
    height: 0.34em;
    fill: none;
    stroke: var(--accent-soft);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: swash-draw 1.6s 0.5s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }

  .swash__line path {
    vector-effect: non-scaling-stroke;
  }

  @keyframes swash-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .a2-hero :global(.a2-hero__fern) {
    position: absolute;
    top: clamp(1rem, 4vw, 3rem);
    width: clamp(4rem, 8vw, 7.5rem);
    height: auto;
    color: var(--accent-soft);
    opacity: 0.75;
    pointer-events: none;
  }

  .a2-hero :global(.a2-hero__fern--l) {
    left: clamp(-2rem, -1vw, 0rem);
    transform: rotate(-24deg);
  }

  .a2-hero :global(.a2-hero__fern--r) {
    right: clamp(-2rem, -1vw, 0rem);
    transform: rotate(24deg);
  }

  /* arched photo composition */
  .a2-hero__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.45fr 1fr;
    align-items: end;
    gap: clamp(0.85rem, 3vw, 3rem);
    max-width: 64rem;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .a2-arch {
    position: relative;
    --offset: clamp(7px, 1.1vw, 14px);
  }

  /* phones: give the center arch more room, tuck the side arches in */
  @media (max-width: 640px) {
    .a2-hero__stage {
      grid-template-columns: 0.72fr 1.9fr 0.72fr;
      gap: 0.6rem;
    }

    .a2-arch--side {
      margin-bottom: 1.25rem;
    }

    .a2-arch :global(.a2-arch__sprig) {
      width: 70%;
    }

    .a2-badge {
      right: -14%;
      width: 4.5rem;
    }
  }

  .a2-arch--side {
    margin-bottom: clamp(1.25rem, 5vw, 4.5rem);
  }

  .a2-arch__outline {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: 1px solid var(--accent-soft);
    border-radius: 999px 999px var(--radius) var(--radius);
    transform: translate(var(--offset), calc(-1 * var(--offset)));
    pointer-events: none;
  }

  .a2-arch--left .a2-arch__outline {
    transform: translate(calc(-1 * var(--offset)), calc(-1 * var(--offset)));
  }

  .a2-arch :global(.photo) {
    position: relative;
    z-index: 1;
  }

  .a2-arch :global(.a2-arch__sprig) {
    position: absolute;
    z-index: 2;
    width: 58%;
    height: auto;
    color: var(--accent);
    pointer-events: none;
  }

  .a2-arch--left :global(.a2-arch__sprig) {
    left: -30%;
    bottom: -12%;
    transform: rotate(-14deg);
  }

  .a2-arch--right :global(.a2-arch__sprig) {
    right: -28%;
    bottom: -8%;
    transform: rotate(16deg);
  }

  .a2-badge {
    position: absolute;
    z-index: 3;
    top: 4%;
    right: -9%;
    width: clamp(4.75rem, 9vw, 7.25rem);
    animation: a2-spin 40s linear infinite;
  }

  .a2-badge__disc {
    fill: var(--surface);
    stroke: var(--line-strong);
  }

  .a2-badge__ring {
    fill: none;
    stroke: var(--accent-soft);
    stroke-dasharray: 2 3;
  }

  .a2-badge text {
    font-family: var(--font-body);
    font-size: 8.6px;
    font-weight: 500;
    text-transform: uppercase;
    fill: var(--ink);
  }

  .a2-badge__leaf {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  @keyframes a2-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .a2-hero__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(1.2rem * var(--display-scale));
    color: var(--ink-soft);
    text-align: center;
  }

  .a2-hero__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-soft);
  }

  /* ---------- Trust ribbon ---------- */
  .ribbon {
    border-block: 1px solid var(--line);
    background: var(--bg-alt);
  }

  .ribbon__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1rem;
    padding-block: 1.5rem;
  }

  .ribbon__item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .ribbon__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--accent-soft);
    outline: 1px dashed var(--line-strong);
    outline-offset: 4px;
    color: var(--accent);
  }

  .ribbon__icon :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
  }

  @media (min-width: 1000px) {
    .ribbon__list {
      display: flex;
      justify-content: space-between;
      padding-block: 1.75rem;
    }

    .ribbon__item + .ribbon__item::before {
      content: '';
      width: 2.5rem;
      height: 1px;
      margin-right: 1.25rem;
      background: var(--line-strong);
    }
  }

  /* ---------- Ornaments ---------- */
  :global(.a2-orn) {
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  :global(.a2-orn--pad) {
    margin-block: clamp(1rem, 2vw, 2rem) clamp(3rem, 2rem + 3vw, 5rem);
  }

  .benefits {
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .benefit .icon-badge {
    background: transparent;
    border: 1px solid var(--accent-soft);
    outline: 1px dashed var(--line-strong);
    outline-offset: 6px;
    margin-bottom: 0.9rem;
  }

  /* ---------- Benefits ---------- */
  .benefits__grid {
    display: grid;
    gap: 2.75rem 2rem;
  }

  .benefit {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    text-align: center;
  }

  .benefit p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 22rem;
  }

  .benefit .icon-badge {
    margin-bottom: 0.4rem;
  }

  @media (min-width: 640px) {
    .benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .benefits__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------- Detail gallery ---------- */
  .details {
    padding-bottom: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  .details__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }

  .details__item {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .details__item:nth-child(even) {
    margin-top: 2.5rem;
  }

  .details__caption {
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line-strong);
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(1.15rem * var(--display-scale));
    line-height: 1.3;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .details__row {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }
  }

  /* ---------- Meet ---------- */
  .meet__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .meet__media {
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }

  .meet__text {
    display: grid;
    gap: 1.35rem;
    justify-items: start;
  }

  .meet__sub {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-style: italic;
    font-size: calc(1.35rem * var(--display-scale));
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .meet .btn-row {
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .meet__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }

  }

  /* meet: outlined arch + branch */
  .meet {
    overflow-x: clip;
  }

