---
/** Interior page intro: eyebrow, title, lede, and an optional photo. */
import Photo from './Photo.astro';
import { rich } from '../lib/utils';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image?: { src: string; alt: string; label?: string };
  stock?: boolean;
}
const { eyebrow, title, lede, image, stock } = Astro.props;
---

<section class:list={['page-header', { 'page-header--image': image }]}>
  <div class="container page-header__inner">
    <div class="page-header__text" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={rich(title)} />
      {lede && <p class="lede" set:html={rich(lede)} />}
      <slot />
    </div>
    {
      image && (
        <div class="page-header__media" data-reveal style="--reveal-delay: .15s">
          <Photo src={image.src} alt={image.alt} label={image.label} shape="feature" aspect="4 / 5" eager stock={stock} sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
      )
    }
  </div>
  <svg class="page-header__sprig" viewBox="0 0 200 300" aria-hidden="true">
    <path d="M100 295C98 220 100 140 120 20" />
    <path d="M101 250c-18-8-34-26-38-48 22 4 36 22 38 48Z" />
    <path d="M103 205c16-10 30-28 32-50-20 6-32 24-32 50Z" />
    <path d="M106 160c-16-8-28-24-30-44 20 4 30 20 30 44Z" />
    <path d="M110 118c14-10 24-26 24-44-18 6-26 22-24 44Z" />
    <path d="M114 78c-12-6-20-20-20-34 14 4 22 16 20 34Z" />
  </svg>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .page-header__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .page-header__text {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    max-width: 44rem;
  }

  .page-header__media {
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }

  /* Phones & tablets: photo first, as a shorter dome */
  @media (max-width: 899px) {
    .page-header--image {
      padding-top: 1rem;
    }

    .page-header--image .page-header__inner {
      gap: 2rem;
    }

    .page-header__media {
      order: -1;
      max-width: none;
    }

    .page-header__media :global(.photo__frame) {
      aspect-ratio: auto;
      height: clamp(14rem, 38vh, 24rem);
    }
  }

  .page-header__sprig {
    position: absolute;
    right: -2rem;
    top: 2rem;
    width: clamp(9rem, 18vw, 15rem);
    fill: none;
    stroke: var(--accent-soft);
    stroke-width: 1.2;
    opacity: 0.7;
    pointer-events: none;
  }

  .page-header--image .page-header__sprig {
    left: -3rem;
    right: auto;
    top: auto;
    bottom: -2rem;
    transform: scaleX(-1) rotate(-10deg);
  }

  @media (min-width: 900px) {
    .page-header--image .page-header__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 6vw, 6rem);
    }

    .page-header__media {
      justify-self: end;
    }
  }
</style>
