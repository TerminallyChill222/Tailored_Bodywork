---
/** Interior page intro: eyebrow, title, lede, and an optional photo. */
import ArchFrame from './ArchFrame.astro';
import { rich } from '../lib/utils';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image?: { src: string; alt: string; label?: string };
}
const { eyebrow, title, lede, image } = Astro.props;
---

<section class:list={['page-header', { 'page-header--image': image }]}>
  <div class="container page-header__inner">
    <div class="page-header__text" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={rich(title)} />
      {lede && <p class="lede" set:html={rich(lede)} />}
      <slot />
    </div>
    {
      image && (
        <div class="page-header__media" data-reveal style="--reveal-delay: .15s">
          <ArchFrame src={image.src} alt={image.alt} label={image.label} aspect="4 / 5" eager sizes="(min-width: 900px) 40vw, 100vw" outline="left" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .page-header__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .page-header__text {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    max-width: 44rem;
  }

  .page-header__media {
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }

  /* Phones & tablets: photo first, as a shorter dome */
  @media (max-width: 899px) {
    .page-header--image {
      padding-top: 1rem;
    }

    .page-header--image .page-header__inner {
      gap: 2rem;
    }

    .page-header__media {
      order: -1;
      max-width: none;
    }

    .page-header__media :global(.photo__frame) {
      aspect-ratio: auto;
      height: clamp(14rem, 38vh, 24rem);
    }
  }

  @media (min-width: 900px) {
    .page-header--image .page-header__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 6vw, 6rem);
    }

    .page-header__media {
      justify-self: end;
    }
  }
</style>
