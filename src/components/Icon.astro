const body = paths[name] ?? paths.sparkle;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
