---
import { rich } from '../lib/utils';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center' | 'split';
  level?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, title, lede, align = 'left', level = 'h2', id } = Astro.props;
const Heading = level;
---

<div class:list={['section-head', { 'section-head--center': align === 'center', 'section-head--split': align === 'split' }]} data-reveal>
  <div class="stack" style="--stack: 1rem">
    {eyebrow && <p class:list={['eyebrow', { 'eyebrow--center': align === 'center' }]}>{eyebrow}</p>}
    <Heading id={id} set:html={rich(title)} />
  </div>
  {lede && <p class="lede" set:html={rich(lede)} />}
  <slot />
</div>
