---
/**
 * Client testimonials. Add real reviews (with the client's permission) in src/data/testimonials.ts.
 * While the list is empty, the section shows a designed empty state — never fabricated quotes.
 */
import SectionHead from './SectionHead.astro';
import { testimonials } from '../data/testimonials';
import { url } from '../lib/utils';

const slots = 3;
---

<section class="section section--alt testimonials" aria-labelledby="kind-words">
  <div class="container">
    <SectionHead eyebrow="Kind words" title="What clients *say*" align="center" id="kind-words" />

    {
      testimonials.length > 0 ? (
        <ul role="list" class="testimonials__grid">
          {testimonials.map((t, i) => (
            <li class="testimonial card" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
              <span class="testimonial__mark" aria-hidden="true">“</span>
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
              <p class="testimonial__name">
                {t.name}
                {t.detail && <span>{t.detail}</span>}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <>
          <ul role="list" class="testimonials__grid" aria-hidden="true">
            {Array.from({ length: slots }).map((_, i) => (
              <li class="testimonial testimonial--empty card" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
                <span class="testimonial__mark">“</span>
                <span class="testimonial__line" />
                <span class="testimonial__line" />
                <span class="testimonial__line testimonial__line--short" />
                <span class="testimonial__name-line" />
              </li>
            ))}
          </ul>
          <p class="testimonials__note" data-reveal>
            Reviews from real clients will appear here as they come in.
            <span class="draft-only"> (Placeholder — add genuine testimonials, with permission, in <code>src/data/testimonials.ts</code>.)</span>
            <br />
            New to Tailored Bodywork? <a class="text-link" href={url('experience')}>See exactly how a session works</a>
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  .testimonials__grid {
    display: grid;
    gap: 1.25rem;
  }

  .testimonial {
    display: grid;
    gap: 1rem;
    align-content: start;
    text-align: left;
  }

  .testimonial blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-size: calc(1.3rem * var(--display-scale));
    line-height: 1.45;
  }

  .testimonial__mark {
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 0.6;
    height: 1.6rem;
    color: var(--accent-soft);
  }

  .testimonial__name {
    display: grid;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .testimonial__name span {
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-soft);
  }

  .testimonial--empty {
    min-height: 15rem;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border-style: dashed;
  }

  .testimonial__line,
  .testimonial__name-line {
    display: block;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--line);
    opacity: 0.8;
  }

  .testimonial__line--short {
    width: 60%;
  }

  .testimonial__name-line {
    width: 35%;
    margin-top: 1.25rem;
    background: var(--line-strong);
    opacity: 0.5;
  }

  .testimonials__note {
    margin: 2.5rem auto 0;
    max-width: 36rem;
    text-align: center;
    color: var(--ink-soft);
    line-height: 2;
  }

  .testimonials__note code {
    font-size: 0.85em;
  }

  @media (min-width: 820px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
