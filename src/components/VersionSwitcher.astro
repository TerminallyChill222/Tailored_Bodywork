---
/**
 * Review-only control for comparing the design directions.
 * Each version has its own pages (Version B lives under /clay/).
 * Remove this component (and site.flags.previewSwitcher) once a direction is chosen.
 */
interface Props {
  items: { id: string; label: string; href: string }[];
  current: string;
}
const { items, current } = Astro.props;
---

<nav class="version-switcher" aria-label="Design version">
  <span class="version-switcher__label">Preview</span>
  {
    items.map((v) =>
      v.id === current ? (
        <span class="version-switcher__item is-current" aria-current="page">
          <span class={`swatch swatch--${v.id}`} aria-hidden="true" />
          {v.label}
        </span>
      ) : (
        <a class="version-switcher__item" href={v.href}>
          <span class={`swatch swatch--${v.id}`} aria-hidden="true" />
          {v.label}
        </a>
      ),
    )
  }
</nav>

<style>
  .version-switcher {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(36 34 32 / 0.9);
    color: #f3efe6;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .version-switcher__label {
    padding: 0 0.6rem 0 0.8rem;
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .version-switcher__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  a.version-switcher__item:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .version-switcher__item.is-current {
    background: #f3efe6;
    color: #24221e;
  }

  .version-switcher__item:focus-visible {
    outline: 2px solid #f3efe6;
    outline-offset: 2px;
  }

  .swatch {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
  }

  .swatch--sage {
    background: linear-gradient(135deg, #a7ae96 50%, #55634a 50%);
  }

  .swatch--clay {
    background: linear-gradient(135deg, #d2a487 50%, #2a2927 50%);
  }

  @media print {
    .version-switcher {
      display: none;
    }
  }
</style>
