---
/**
 * Fine-line botanical drawing (olive, eucalyptus, or fern), generated along a gently curved stem
 * so every branch has the same hand-drawn line quality. Stroke follows `currentColor`.
 * The stem grows from the bottom-center of the box toward the top.
 */
interface Props {
  kind?: 'olive' | 'eucalyptus' | 'fern';
  /** Horizontal drift of the tip, as a fraction of the width (-1 … 1). */
  bend?: number;
  leaves?: number;
  class?: string;
  /** Extra leaf at the very tip. */
  tip?: boolean;
}

const { kind = 'olive', bend = 0.35, leaves = kind === 'fern' ? 16 : 9, class: className = '', tip = true } = Astro.props;

const W = 120;
const H = 300;
const p0 = { x: W / 2, y: H };
const p2 = { x: W / 2 + bend * (W / 2) * 0.9, y: 6 };
const p1 = { x: W / 2 - bend * (W / 2) * 0.5, y: H * 0.5 };

const at = (t: number) => ({
  x: (1 - t) ** 2 * p0.x + 2 * (1 - t) * t * p1.x + t ** 2 * p2.x,
  y: (1 - t) ** 2 * p0.y + 2 * (1 - t) * t * p1.y + t ** 2 * p2.y,
});
const angleAt = (t: number) => {
  const dx = 2 * (1 - t) * (p1.x - p0.x) + 2 * t * (p2.x - p1.x);
  const dy = 2 * (1 - t) * (p1.y - p0.y) + 2 * t * (p2.y - p1.y);
  return (Math.atan2(dy, dx) * 180) / Math.PI;
};
const f = (n: number) => Math.round(n * 10) / 10;

const stem = `M${f(p0.x)} ${f(p0.y)} Q${f(p1.x)} ${f(p1.y)} ${f(p2.x)} ${f(p2.y)}`;

type Leaf = { x: number; y: number; rot: number; len: number; wid: number; vein: boolean };
const leafList: Leaf[] = [];
const berries: { x: number; y: number; rot: number }[] = [];

for (let i = 0; i < leaves; i++) {
  const t = 0.14 + (i / Math.max(leaves - 1, 1)) * 0.78;
  const { x, y } = at(t);
  const a = angleAt(t);
  const taper = 1 - t * 0.45;
  if (kind === 'olive') {
    const side = i % 2 === 0 ? -1 : 1;
    leafList.push({ x, y, rot: a + side * (34 + (i % 3) * 5), len: 46 * taper, wid: 7.5 * taper, vein: true });
    if (i % 3 === 1) berries.push({ x, y, rot: a - side * 70 });
  } else if (kind === 'eucalyptus') {
    for (const side of [-1, 1]) leafList.push({ x, y, rot: a + side * 78, len: 24 * taper + 6, wid: 10 * taper + 3, vein: false });
  } else {
    for (const side of [-1, 1]) leafList.push({ x, y, rot: a + side * 58, len: 26 * taper, wid: 4.5 * taper, vein: false });
  }
}
if (tip) {
  const { x, y } = at(0.96);
  leafList.push({ x, y, rot: angleAt(0.96), len: kind === 'eucalyptus' ? 16 : 30, wid: kind === 'eucalyptus' ? 8 : 6, vein: kind === 'olive' });
}

const leafPath = (l: Leaf) =>
  `M0 0 C${f(l.len * 0.3)} ${f(-l.wid)} ${f(l.len * 0.75)} ${f(-l.wid)} ${f(l.len)} 0 C${f(l.len * 0.75)} ${f(l.wid)} ${f(l.len * 0.3)} ${f(l.wid)} 0 0Z`;
---

<svg class:list={['sprig', `sprig--${kind}`, className]} viewBox={`0 0 ${W} ${H}`} fill="none" aria-hidden="true">
  <path d={stem} vector-effect="non-scaling-stroke" />
  {
    leafList.map((l) => (
      <g transform={`translate(${f(l.x)} ${f(l.y)}) rotate(${f(l.rot)})`}>
        <path d={leafPath(l)} vector-effect="non-scaling-stroke" />
        {l.vein && <path d={`M2 0 L${f(l.len * 0.82)} 0`} class="sprig__vein" vector-effect="non-scaling-stroke" />}
      </g>
    ))
  }
  {
    berries.map((b) => (
      <ellipse cx={f(b.x)} cy={f(b.y)} rx="3.6" ry="5" transform={`rotate(${f(b.rot)} ${f(b.x)} ${f(b.y)}) translate(0 -9)`} vector-effect="non-scaling-stroke" />
    ))
  }
</svg>

<style>
  .sprig {
    display: block;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sprig__vein {
    opacity: 0.55;
  }
</style>
