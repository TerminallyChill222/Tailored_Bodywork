---
/** Background photo for a full-bleed `.bleed` section. */
import { imgSrc, imgSrcset } from '../../lib/utils';

interface Props {
  src: string;
  alt?: string;
  eager?: boolean;
  position?: string;
}
const { src, alt = '', eager = false, position = 'center' } = Astro.props;
---

<img
  class="bleed__img"
  src={imgSrc(src, 1920)}
  srcset={imgSrcset(src, [768, 1080, 1440, 1920, 2560])}
  width="1600"
  height="1067"
  sizes="100vw"
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  style={`object-position: ${position}`}
/>
