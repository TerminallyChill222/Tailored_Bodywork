---
/** Version B header: charcoal announcement bar + centered wordmark with split navigation. */
import LogoClay from './LogoClay.astro';
import { site } from '../../data/site';
import { vurl, bookingHref } from '../../lib/utils';

const left = [
  { label: 'About', href: 'about' },
  { label: 'Services', href: 'services' },
  { label: 'Experience', href: 'experience' },
];
const right = [
  { label: 'FAQ', href: 'faq' },
  { label: 'Contact', href: 'contact' },
];
const all = [{ label: 'Home', href: '' }, ...left, ...right];

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === vurl('clay', href).replace(/\/$/, '');
---

<div class="announce">
  <p>
    <span class="announce__long">In-home bodywork across {site.serviceArea.summary} ·</span>
    <a href={bookingHref('clay')}>Book a session <span aria-hidden="true">→</span></a>
  </p>
</div>

<header class="hc" data-header>
  <div class="hc__inner">
    <button class="hc__toggle" type="button" aria-expanded="false" aria-controls="clay-menu" data-menu-toggle>
      <span class="hc__toggle-bars" aria-hidden="true"><span></span><span></span></span>
      <span class="hc__toggle-label">Menu</span>
    </button>

    <nav class="hc__nav hc__nav--left" aria-label="Main">
      <ul role="list">
        {left.map((i) => <li><a href={vurl('clay', i.href)} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="hc__logo"><LogoClay /></div>

    <div class="hc__right">
      <nav class="hc__nav" aria-label="More">
        <ul role="list">
          {right.map((i) => <li><a href={vurl('clay', i.href)} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn--primary hc__book" href={bookingHref('clay')}>Book</a>
    </div>
  </div>

  <div class="hc__menu" id="clay-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ol role="list">
        {
          all.map((i, n) => (
            <li>
              <a href={vurl('clay', i.href)} aria-current={isCurrent(i.href) ? 'page' : undefined}>
                <span class="hc__menu-num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
                {i.label}
              </a>
            </li>
          ))
        }
      </ol>
      <a class="btn btn--light" href={bookingHref('clay')}>Book a session</a>
      <p class="hc__menu-meta">{site.serviceArea.summary}</p>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header?.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .announce {
    background: var(--band);
    color: var(--band-soft);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.7rem 1rem;
  }

  .announce a {
    color: var(--band-ink);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--band-ink) 40%, transparent);
    padding-bottom: 1px;
    margin-left: 0.4rem;
    transition: border-color 0.25s ease;
  }

  .announce a:hover {
    border-color: var(--band-ink);
  }

  .announce__long {
    display: none;
  }

  .hc {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.35s ease;
  }

  .hc.is-scrolled {
    box-shadow: 0 10px 30px -24px rgb(0 0 0 / 0.4);
  }

  .hc__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 5.25rem;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    max-width: 90rem;
    margin-inline: auto;
  }

  .hc__toggle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .hc__toggle-bars {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .hc__toggle-bars span {
    display: block;
    height: 1px;
    background: var(--ink);
    transition: transform 0.3s ease;
  }

  [aria-expanded='true'] .hc__toggle-bars span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  [aria-expanded='true'] .hc__toggle-bars span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .hc__toggle-label {
    display: none;
  }

  .hc__nav {
    display: none;
  }

  .hc__nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }

  .hc__nav a {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .hc__nav a:hover,
  .hc__nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .hc__logo {
    justify-self: center;
  }

  .hc__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }

  .hc__book {
    min-height: 2.6rem !important;
    padding: 0.7em 1.4em !important;
  }

  /* Mobile menu: full-height charcoal panel */
  .hc__menu {
    position: absolute;
    inset: 100% 0 auto;
    height: calc(100dvh - 5.25rem);
    overflow-y: auto;
    background: var(--band);
    color: var(--band-ink);
    padding-block: 2rem 4rem;
  }

  .hc__menu ol {
    display: grid;
    margin-bottom: 2.5rem;
  }

  .hc__menu li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--band-soft) 22%, transparent);
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--band-ink);
  }

  .hc__menu li a[aria-current='page'] {
    color: var(--accent-soft);
  }

  .hc__menu-num {
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--band-soft);
  }

  .hc__menu .btn {
    width: 100%;
  }

  .hc__menu-meta {
    margin-top: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--band-soft);
    text-align: center;
  }

  @media (min-width: 560px) {
    .hc__toggle-label {
      display: inline;
    }
  }

  @media (min-width: 760px) {
    .announce__long {
      display: inline;
    }
  }

  @media (min-width: 1080px) {
    .hc__toggle {
      display: none;
    }

    .hc__nav {
      display: block;
    }

    .hc__nav--left {
      justify-self: start;
    }
  }

  @media (max-width: 1079px) {
    .hc__right .hc__nav {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .hc :global(.logo-clay__tag) {
      display: none;
    }

    .hc :global(.logo-clay__name) {
      font-size: 0.92rem;
      letter-spacing: 0.12em;
    }

    .hc__book {
      padding: 0.6em 1em !important;
    }
  }
</style>
