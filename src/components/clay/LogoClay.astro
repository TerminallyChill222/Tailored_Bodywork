---
import { site } from '../../data/site';
import { vurl } from '../../lib/utils';

interface Props {
  tone?: 'default' | 'light';
  size?: 'default' | 'small';
}
const { tone = 'default', size = 'default' } = Astro.props;
---

<a href={vurl('clay')} class:list={['logo-clay', `logo-clay--${tone}`, `logo-clay--${size}`]} aria-label={`${site.name} — home`}>
  <svg class="logo-clay__mark" viewBox="0 0 40 24" aria-hidden="true">
    <path d="M6 20a14 14 0 0 1 28 0" />
    <path d="M12 20a8 8 0 0 1 16 0" stroke-dasharray="1.4 2.2" />
    <path d="M2 20h36" />
  </svg>
  <span class="logo-clay__name">Tailored Bodywork</span>
  <span class="logo-clay__tag">Mobile bodywork · {site.city}</span>
</a>

<style>
  .logo-clay {
    display: inline-grid;
    justify-items: center;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
    line-height: 1;
  }

  .logo-clay--light {
    color: var(--band-ink);
  }

  .logo-clay__mark {
    width: 2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linecap: round;
    margin-bottom: 0.2rem;
  }

  .logo-clay--light .logo-clay__mark {
    stroke: var(--accent-soft);
  }

  .logo-clay__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo-clay__tag {
    margin-top: 0.35rem;
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .logo-clay--light .logo-clay__tag {
    color: var(--band-soft);
  }

  .logo-clay--small .logo-clay__mark,
  .logo-clay--small .logo-clay__tag {
    display: none;
  }

  .logo-clay--small .logo-clay__name {
    font-size: 0.95rem;
  }
</style>
