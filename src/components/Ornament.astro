---
/** Botanical section divider: fine rule — two olive sprigs — fine rule. */
import Sprig from './Sprig.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['ornament', className]} aria-hidden="true">
  <span class="ornament__rule"></span>
  <span class="ornament__sprigs">
    <span class="ornament__slot"><Sprig kind="olive" bend={0.15} leaves={6} class="ornament__sprig ornament__sprig--l" /></span>
    <span class="ornament__dot"></span>
    <span class="ornament__slot"><Sprig kind="olive" bend={0.15} leaves={6} class="ornament__sprig ornament__sprig--r" /></span>
  </span>
  <span class="ornament__rule"></span>
</div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 34rem;
    margin-inline: auto;
    color: var(--accent-soft);
  }

  .ornament__rule {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.8;
  }

  .ornament__sprigs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
  }

  .ornament__slot {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 1.75rem;
  }

  .ornament__sprigs :global(.ornament__sprig) {
    width: 1.7rem;
    height: 4.25rem;
  }

  .ornament__sprigs :global(.ornament__sprig--l) {
    transform: rotate(-90deg);
  }

  .ornament__sprigs :global(.ornament__sprig--r) {
    transform: rotate(90deg) scaleX(-1);
  }

  .ornament__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
</style>
