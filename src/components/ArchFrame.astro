---
/**
 * An arched photo with a fine offset outline that echoes its shape.
 * Takes the same photo props as <Photo>.
 */
import Photo from './Photo.astro';

interface Props {
  src?: string;
  alt?: string;
  label?: string;
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  position?: string;
  stock?: boolean;
  /** Which way the outline is offset (it always sits slightly above the photo). */
  outline?: 'left' | 'right';
  class?: string;
}

const { outline = 'right', class: className = '', ...photo } = Astro.props;
---

<div class:list={['arch-frame', `arch-frame--outline-${outline}`, className]}>
  <span class="arch-frame__outline" aria-hidden="true"></span>
  <Photo {...photo} shape="feature" />
</div>

<style>
  .arch-frame {
    position: relative;
    --offset: clamp(8px, 1.2vw, 16px);
  }

  .arch-frame__outline {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: 1px solid var(--accent-soft);
    border-radius: var(--radius-feature);
    transform: translate(var(--offset), calc(-1 * var(--offset)));
    pointer-events: none;
  }

  .arch-frame--outline-left .arch-frame__outline {
    transform: translate(calc(-1 * var(--offset)), calc(-1 * var(--offset)));
  }

  .arch-frame :global(.photo) {
    position: relative;
    z-index: 1;
  }

</style>
