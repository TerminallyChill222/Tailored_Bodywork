---
import '../styles/global.css';
import '../styles/clay.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeaderClay from '../components/clay/HeaderClay.astro';
import FooterClay from '../components/clay/FooterClay.astro';
import VersionSwitcher from '../components/VersionSwitcher.astro';
import { site } from '../data/site';
import { url, plain, counterpart, imgSrc, type Version } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Which design direction this page belongs to. */
  version?: Version;
}

const { title, description = site.description, image, version = 'sage' } = Astro.props;
const fullTitle = title
  ? `${title} | ${site.name} — Mobile Bodywork in ${site.city}`
  : `${site.name} | Mobile, In-Home Bodywork in ${site.city}, ${site.regionCode}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogSrc = image ? imgSrc(image, 1600) : undefined;
const ogImage = ogSrc?.startsWith('http') ? ogSrc : ogSrc && Astro.site ? new URL(ogSrc, Astro.site).href : undefined;
const { draft, previewSwitcher, structuredData } = site.flags;
const otherVersion: Version = version === 'sage' ? 'clay' : 'sage';
const otherHref = counterpart(Astro.url.pathname, otherVersion);
const switcherItems = [
  { id: 'sage', label: 'A · Sage', href: counterpart(Astro.url.pathname, 'sage') },
  { id: 'clay', label: 'B · Clay', href: counterpart(Astro.url.pathname, 'clay') },
];
const switcherCurrent = version;

// Only emitted once site.flags.structuredData is on and details are verified.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  founder: { '@type': 'Person', name: site.practitioner.fullName },
  telephone: site.contact.phone,
  email: site.contact.email,
  areaServed: { '@type': 'City', name: `${site.city}, ${site.region}` },
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.regionCode, addressCountry: 'US' },
};

const fonts: Record<Version, string> = {
  sage: 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap',
  clay: 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600&display=swap',
};
const themeColor: Record<Version, string> = { sage: '#f6f2ea', clay: '#f3eee7' };
---

<!doctype html>
<html lang="en" data-theme={version} class:list={{ 'is-draft': draft }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plain(fullTitle)}</title>
    <meta name="description" content={plain(description)} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={plain(fullTitle)} />
    <meta property="og:description" content={plain(description)} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={themeColor[version]} />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="stylesheet" href={fonts[version]} />

    <script is:inline define:vars={{ version, otherHref }}>
      document.documentElement.classList.add('js');
      // Older review links used ?v=clay / ?v=sage — send them to the matching page.
      var v = new URLSearchParams(location.search).get('v');
      if ((v === 'sage' || v === 'clay') && v !== version) location.replace(otherHref);
    </script>

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {version === 'clay' ? <HeaderClay /> : <Header />}
    <main id="main">
      <slot />
    </main>
    {version === 'clay' ? <FooterClay /> : <Footer />}
    {previewSwitcher && <VersionSwitcher items={switcherItems} current={switcherCurrent} />}

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
